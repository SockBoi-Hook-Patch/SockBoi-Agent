# Copy this file to .env and replace the placeholders before starting Compose.
# Generate a URL-safe PostgreSQL password with:
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret

# Add server-side key records. Empty list intentionally fails closed (HTTP 503).
SOCKBOI_API_KEYS=[]

# Optional until using audit checkpoint export; keep separate from the database.
SOCKBOI_AUDIT_CHECKPOINT_KEY=
